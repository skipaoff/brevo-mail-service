# ---------------------------------------------------------------- почта
# Способ 1 (рекомендуется): API Brevo. Ключ: Brevo → SMTP & API → API Keys.
# Начинается с xkeysib-. Для API-ключа уместно ограничение по IP сервера.
BREVO_API_KEY=

# Способ 2: SMTP Brevo. Ключ: Brevo → SMTP & API → SMTP → Generate a new SMTP key.
# Начинается с xsmtpsib-. Это НЕ тот же ключ, что API-ключ.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# Если заданы оба способа, берётся API. Выбрать явно: smtp | brevo_api
MAIL_TRANSPORT=

# От кого письмо. Домен должен быть подтверждён в Brevo (см. docs/brevo-setup.md).
MAIL_FROM=Название продукта <noreply@example.com>
# Куда уйдёт ответ человека. Можно оставить пустым.
MAIL_REPLY_TO=support@example.com

# ---------------------------------------------------------------- сервис
# Общий секрет с бэкендом: тот шлёт Authorization: Bearer <SERVICE_TOKEN>.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_TOKEN=
# Подпись кодов подтверждения. Сгенерировать так же. Сменить = погасить все живые коды.
CODE_SECRET=

# SQLite по умолчанию. Для Postgres: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./data/mail.db

# ---------------------------------------------------------------- вид писем
# Название в шапке и подвале. Пусто — берётся имя из MAIL_FROM.
BRAND_NAME=Название продукта
BRAND_TAGLINE=Одна строка о том, что делает продукт
SITE_URL=https://example.com
PRIVACY_URL=https://example.com/privacy
# Логотип вместо названия в шапке (PNG по https, высота ~28px). Пусто — название текстом.
LOGO_URL=
HEADER_BG="#111827"
ACCENT_COLOR="#2563eb"
ACCENT_TEXT_COLOR="#ffffff"

# Язык встроенных писем: ru | uk | en. В запросе можно передать свой lang.
MAIL_LANG=ru
# Свои формулировки без правки кода: JSON {"ru": {"code_lead": "..."}}.
# Список ключей — mailservice/texts.py. Файл читается один раз: после правки перезапустите сервис.
TEXTS_FILE=

# Письмо с кодом из шаблона, свёрстанного в Brevo (только при BREVO_API_KEY).
# В шаблоне доступны {{ params.code }}, {{ params.minutes }}, {{ params.brand }}.
CODE_TEMPLATE_ID=

# ---------------------------------------------------------------- коды
CODE_MINUTES=15
CODE_DIGITS=6
CODE_MAX_ATTEMPTS=5
CODES_PER_EMAIL_HOUR=3
CODES_PER_IP_HOUR=20
